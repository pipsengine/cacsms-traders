# Local IIS - copy to repo root as .env (scripts/setup-iis.ps1 can create a starter file).

APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000

# Must match the URL you open in the browser (no trailing slash).
WEB_ORIGINS=http://localhost:8080

# Optional: only set if you also forward x-ct-proxy-secret from IIS (see README IIS section).
# API_PROXY_SECRET=

BOOTSTRAP_USERNAME=cacsms
BOOTSTRAP_PASSWORD=ChangeMe!2026
