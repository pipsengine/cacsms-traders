APP_NAME=Cacsms-Traders
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
WEB_ORIGIN=http://localhost:5173
# Dev: from repo root run `npm run dev` (kills stale :8000/:5173, starts API + Vite)
# API uses `py -3.14` (not .venv) unless you activate a venv yourself. Install MT5: py -3.14 -m pip install MetaTrader5
# Optional comma-separated extra CORS origins (development also allows localhost/127.0.0.1:5173)
# Production frontend (Vercel): https://cacsms-traders.vercel.app
WEB_ORIGINS=https://cacsms-traders.vercel.app
DATABASE_PATH=database/db_cacsms-traders.db
# With APP_ENV=production a missing database file is an error (never auto-created). Set to 1 only for first provisioning.
# DATABASE_ALLOW_CREATE=0
SESSION_HOURS=12
# Session cookie (ct_session, HttpOnly, Path=/api). Secure is forced in production; SameSite lax|strict.
# SESSION_COOKIE_SAMESITE=lax
# SESSION_COOKIE_SECURE=   (development override only)
# Shared secret sent by the Vercel /api proxy (x-ct-proxy-secret). When set, forwarded/public requests without it get 403.
# API_PROXY_SECRET=
# cTrader Open API (server-side only — never VITE_*). Redirect URI must be registered in the cTrader app.
# CTRADER_CLIENT_ID=
# CTRADER_CLIENT_SECRET=
# CTRADER_REDIRECT_URI=https://cacsms-traders.vercel.app/api/connections/ctrader/callback
# CTRADER_ENVIRONMENT=demo
BOOTSTRAP_USERNAME=cacsms
BOOTSTRAP_PASSWORD=ChangeMe!2026
BOOTSTRAP_EMAIL=admin@cacsms.local
# Global super administrator (created on API bootstrap; cannot be deleted)
# SUPER_ADMIN_USERNAME=Admin
# SUPER_ADMIN_EMAIL=cacsmstraders@cacsms.com
# SUPER_ADMIN_PASSWORD=set-in-production
# SUPER_ADMIN_SYNC_PASSWORD=1
LOG_LEVEL=INFO
MT5_MODE=local
# Broker symbol decoration for the 28-pair basket (e.g. suffix=m for micro)
MT5_SYMBOL_PREFIX=
MT5_SYMBOL_SUFFIX=
# Background intelligence worker (ingest + CSM + relationships)
MI_WORKER_ENABLED=0
MI_WORKER_INTERVAL=300
# Optional: pip install MetaTrader5 (Windows, terminal running & logged in)
# MT5 terminal path is configured per tenant in System Control → MT5 Connections (not via .env).
